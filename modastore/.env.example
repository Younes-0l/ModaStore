# Copy to .env and adjust. NOTE: keep these names in sync with modastore/settings.py.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
DB_NAME=modastore
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Payments (ZarinPal v4) ---
# Leave the merchant id as the sandbox/dummy value for local development.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True

# --- SMS (OTP login) ---
# In development the code is printed to the console instead of being sent.
SMS_BACKEND=console
